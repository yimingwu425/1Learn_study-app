{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider-neutral Cambridge question proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_run_id",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "agent_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exam_key",
          "question_no",
          "subparts",
          "question",
          "answer",
          "figures",
          "confidence",
          "exception_flags",
          "stem_text",
          "answer_text"
        ],
        "properties": {
          "exam_key": {
            "type": "string",
            "pattern": "^(9702|9708)/[0-9]{2}/(m|s|w)/20[0-9]{2}$"
          },
          "question_no": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,2}$"
          },
          "subparts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z](?:\\.(?:i|ii|iii|iv|v|vi|vii|viii|ix|x))?$"
            },
            "uniqueItems": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "exception_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "question": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "page",
                "bbox",
                "quote"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "quote": {
                  "type": "string",
                  "maxLength": 20000
                }
              }
            },
            "maxItems": 500,
            "minItems": 1
          },
          "answer": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "page",
                "bbox",
                "quote"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "quote": {
                  "type": "string",
                  "maxLength": 20000
                }
              }
            },
            "maxItems": 500,
            "minItems": 0
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "page",
                "bbox",
                "quote"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "quote": {
                  "type": "string",
                  "maxLength": 20000
                }
              }
            },
            "maxItems": 500,
            "minItems": 0
          },
          "stem_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "answer_text": {
            "type": "string",
            "maxLength": 100000
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 30,
            "uniqueItems": true
          },
          "syllabus_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{1,2}(\\.\\d{1,2}){0,2}$"
            },
            "maxItems": 30,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 200
    }
  }
}
